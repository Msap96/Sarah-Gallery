{
  "name": "sarah-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:local": "vite --port=3000 --host=localhost",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/generate-images.mjs",
    "predev": "npm run images",
    "prebuild": "npm run images",
    "lint": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run build && npm run lint && npm test && npm run verify:build",
    "test": "node --test tests/*.test.mjs",
    "dev:worker": "wrangler dev",
    "preview:worker": "wrangler dev --port 8787",
    "postbuild": "node scripts/generate-metadata.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.3.2",
    "wrangler": "^4.146.0"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
